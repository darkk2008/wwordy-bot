# Copy this file to .env (never commit .env) and fill it in.

# From @BotFather when you create the bot
TELEGRAM_BOT_TOKEN=

# Any random string of letters, digits, _ or - (up to 256 chars). Make one with:  openssl rand -hex 24
# Telegram sends it with every update, and the function rejects requests without it.
TELEGRAM_WEBHOOK_SECRET=

# Public address of THIS bot's Netlify site, no trailing slash (used by `npm run webhook`)
SITE_URL=https://your-bot-site.netlify.app

# Optional: the wwordy web app. Gives the bot an "Open wwordy" menu button (a Telegram Mini App) and /app
WEBAPP_URL=https://yourdomain.com/app/
